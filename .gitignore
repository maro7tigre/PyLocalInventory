build/
dist/
output/
tmp/
*.spec
!PyLocalInventory.spec
*.manifest
*.zip
*.7z
*.rar
*.egg-info/

# Runtime-generated/private application data
profiles/*
logs/
*.log
*.tmp
*.temp
local_settings.py
db.sqlite3
db.sqlite3-journal

# Editor and OS metadata
.vscode/
.idea/
.DS_Store
Thumbs.db
